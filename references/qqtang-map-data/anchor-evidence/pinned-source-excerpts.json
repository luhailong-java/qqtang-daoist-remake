          "lines": [
            "// original client uses 40-pixel cells; keeping geometry in cells avoids",
            "// leaking rendering coordinates into the deterministic battle core.",
            "type CompetitiveBattlefield struct {",
            "\tWidth  uint16",
            "\tHeight uint16",
            "\tCells  []CompetitiveBattleCell"
          ]
        },
        {
          "startLine": 43,
          "endLine": 55,
          "lines": [
            "\t// FUN_005cfc10 queries only scene+0xe2c (serialized layer zero) at",
            "\t// the actor's origin. Destination collision still checks both layers.",
            "\tNativePlayerExitAttr    uint32",
            "\tNativePlayerExitAttrSet bool",
            "\t// MapElementOccupied is independent of actor traversal. Client.exe first",
            "\t// uses GridAttr bits 0..3 for directional actor traversal, but",
            "\t// its local bubble producer separately rejects every cell for which the",
            "\t// static map-element lookup returns an object.",
            "\tMapElementOccupied bool",
            "\tDurability         byte",
            "\tMapElementID       uint32",
            "\tNormalPushable     bool",
            "\tPandaPushable      bool"
          ]
        },
        {
          "startLine": 88,
          "endLine": 99,
          "lines": [
            "\tmapElementClassLine = regexp.MustCompile(`^class\\s+QQTMapElem([0-9]+)\\(QQTMapElem\\):`)",
            "\tmapElementIntLine   = regexp.MustCompile(`^(LifeTime|imageID|canMove)\\s*=\\s*(-?[0-9]+)\\s*$`)",
            "\tmapElementSizeLine  = regexp.MustCompile(`^size\\s*=\\s*\\(\\s*([0-9]+)\\s*,\\s*([0-9]+)\\s*\\)\\s*$`)",
            "\tmapElementAttrsLine = regexp.MustCompile(`^GridAttr\\s*=\\s*\\(([^)]*)\\)\\s*$`)",
            ")",
            "",
            "func loadCompetitiveMapElements(path string) (map[uint32]competitiveMapElement, error) {",
            "\tfile, err := os.Open(path)",
            "\tif err != nil {",
            "\t\treturn nil, fmt.Errorf(\"open map-element catalog: %w\", err)",
            "\t}",
            "\tdefer file.Close()"
          ]
        },
        {
          "startLine": 134,
          "endLine": 184,
          "lines": [
            "\t\tif fields := mapElementClassLine.FindStringSubmatch(line); fields != nil {",
            "\t\t\tif err := commit(); err != nil {",
            "\t\t\t\treturn nil, err",
            "\t\t\t}",
            "\t\t\tid, _ := strconv.ParseUint(fields[1], 10, 32)",
            "\t\t\tcurrent = &competitiveMapElement{id: uint32(id), lifeTime: -1, width: 1, height: 1, gridAttrs: []uint32{0}}",
            "\t\t\tcontinue",
            "\t\t}",
            "\t\tif current == nil {",
            "\t\t\tcontinue",
            "\t\t}",
            "\t\tif fields := mapElementIntLine.FindStringSubmatch(line); fields != nil {",
            "\t\t\tvalue, parseErr := strconv.ParseInt(fields[2], 10, 32)",
            "\t\t\tif parseErr != nil {",
            "\t\t\t\treturn nil, fmt.Errorf(\"parse map element %d %s: %w\", current.id, fields[1], parseErr)",
            "\t\t\t}",
            "\t\t\tswitch fields[1] {",
            "\t\t\tcase \"LifeTime\":",
            "\t\t\t\tcurrent.lifeTime = int(value)",
            "\t\t\tcase \"imageID\":",
            "\t\t\t\tcurrent.id = uint32(value)",
            "\t\t\tcase \"canMove\":",
            "\t\t\t\tif value < 0 {",
            "\t\t\t\t\treturn nil, fmt.Errorf(\"map element %d has negative canMove %d\", current.id, value)",
            "\t\t\t\t}",
            "\t\t\t\tcurrent.canMove = uint32(value)",
            "\t\t\t}",
            "\t\t\tcontinue",
            "\t\t}",
            "\t\tif fields := mapElementSizeLine.FindStringSubmatch(line); fields != nil {",
            "\t\t\twidth, _ := strconv.Atoi(fields[1])",
            "\t\t\theight, _ := strconv.Atoi(fields[2])",
            "\t\t\tcurrent.width, current.height = width, height",
            "\t\t\tcontinue",
            "\t\t}",
            "\t\tif fields := mapElementAttrsLine.FindStringSubmatch(line); fields != nil {",
            "\t\t\tparts := strings.Split(fields[1], \",\")",
            "\t\t\tattrs := make([]uint32, 0, len(parts))",
            "\t\t\tfor _, part := range parts {",
            "\t\t\t\tpart = strings.TrimSpace(part)",
            "\t\t\t\tif part == \"\" {",
            "\t\t\t\t\tcontinue",
            "\t\t\t\t}",
            "\t\t\t\tvalue, parseErr := strconv.ParseUint(part, 0, 32)",
            "\t\t\t\tif parseErr != nil {",
            "\t\t\t\t\treturn nil, fmt.Errorf(\"parse map element %d GridAttr %q: %w\", current.id, part, parseErr)",
            "\t\t\t\t}",
            "\t\t\t\tattrs = append(attrs, uint32(value))",
            "\t\t\t}",
            "\t\t\tif len(attrs) == 0 {",
            "\t\t\t\treturn nil, fmt.Errorf(\"map element %d has empty GridAttr\", current.id)"
          ]
        },
        {
          "startLine": 223,
          "endLine": 264,
          "lines": [
            "\t\tbase := headerSize + layer*layerBytes",
            "\t\tfor row := 0; row < int(height); row++ {",
            "\t\t\tfor col := 0; col < int(width); col++ {",
            "\t\t\t\traw := int32(binary.LittleEndian.Uint32(mapBytes[base+(row*int(width)+col)*4:]))",
            "\t\t\t\t// FUN_005d80e1 copies the serialized layer, but creates a",
            "\t\t\t\t// CMapElem only for positive entries. Negative entries are editor",
            "\t\t\t\t// continuation markers; they never create an object on their own.",
            "\t\t\t\t// FUN_005d839c then projects the positive anchor over the configured",
            "\t\t\t\t// mapElem.py footprint. Treating an orphan negative marker as an",
            "\t\t\t\t// occupied cell invents a wall that does not exist in Client.exe.",
            "\t\t\t\tif raw <= 0 {",
            "\t\t\t\t\tcontinue",
            "\t\t\t\t}",
            "\t\t\t\telement, ok := elements[uint32(raw)]",
            "\t\t\t\tif !ok {",
            "\t\t\t\t\t// A few special-rule maps reference server-era elements that",
            "\t\t\t\t\t// are absent from the shipped Python catalog. Preserve safety",
            "\t\t\t\t\t// by treating the positive anchor cell as solid. Its unknown",
            "\t\t\t\t\t// footprint cannot be inferred from negative editor markers. The",
            "\t\t\t\t\t// restricted rule-1 engine never assigns behaviour to it.",
            "\t\t\t\t\tprevious := field.Cells[row*int(width)+col]",
            "\t\t\t\t\tif layer == 0 {",
            "\t\t\t\t\t\tprevious.NativePlayerExitAttr = 0",
            "\t\t\t\t\t}",
            "\t\t\t\t\tfield.Cells[row*int(width)+col] = CompetitiveBattleCell{Collision: CompetitiveCellSolid, MapElementOccupied: true,",
            "\t\t\t\t\t\tNativePlayerExitAttr: previous.NativePlayerExitAttr, NativePlayerExitAttrSet: true}",
            "\t\t\t\t\tcontinue",
            "\t\t\t\t}",
            "\t\t\t\tfor localRow := 0; localRow < element.height; localRow++ {",
            "\t\t\t\t\tfor localCol := 0; localCol < element.width; localCol++ {",
            "\t\t\t\t\t\ttargetRow, targetCol := row+localRow, col+localCol",
            "\t\t\t\t\t\tif targetRow >= int(height) || targetCol >= int(width) {",
            "\t\t\t\t\t\t\treturn CompetitiveBattlefield{}, fmt.Errorf(\"map element %d at %d,%d exceeds %dx%d\", raw, row, col, width, height)",
            "\t\t\t\t\t\t}",
            "\t\t\t\t\t\t// The Python comment names four groups, not four individual",
            "\t\t\t\t\t\t// bits. Native movement/flame methods select a direction bit.",
            "\t\t\t\t\t\tattr := element.gridAttrs[localRow*element.width+localCol]",
            "\t\t\t\t\t\t// FUN_005d839c writes the object pointer and attributes into",
            "\t\t\t\t\t\t// every footprint cell. A later positive anchor replaces the",
            "\t\t\t\t\t\t// earlier pointer at overlapping cells, so native row-major",
            "\t\t\t\t\t\t// installation is last-writer-wins rather than a union of",
            "\t\t\t\t\t\t// collision flags."
          ]
        }
      ]
