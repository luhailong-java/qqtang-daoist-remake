      "transport": "GitHub connector fetch_file",
      "excerpts": [
        {
          "startLine": 72,
          "endLine": 103,
          "lines": [
            "// DecodeDIMG converts the first visible frame into the resource's declared",
            "// canvas. It is intentionally strict and is used for standalone UI icons.",
            "func DecodeDIMG(data []byte) (*image.RGBA, error) {",
            "\tsprite, err := parseDIMG(data)",
            "\tif err != nil {",
            "\t\treturn nil, err",
            "\t}",
            "\tframe, err := firstVisibleFrame(sprite.frames)",
            "\tif err != nil {",
            "\t\treturn nil, err",
            "\t}",
            "\tif frame.x < 0 || frame.y < 0 || frame.x+frame.image.Bounds().Dx() > sprite.width || frame.y+frame.image.Bounds().Dy() > sprite.height {",
            "\t\treturn nil, fmt.Errorf(\"invalid QQF/DIMG canvas %dx%d frame %d,%d %dx%d\", sprite.width, sprite.height, frame.x, frame.y, frame.image.Bounds().Dx(), frame.image.Bounds().Dy())",
            "\t}",
            "\tresult := image.NewRGBA(image.Rect(0, 0, sprite.width, sprite.height))",
            "\tdraw.Draw(result, frame.image.Bounds().Add(image.Pt(frame.x, frame.y)), frame.image, frame.image.Bounds().Min, draw.Over)",
            "\treturn result, nil",
            "}",
            "",
            "// DecodeDIMGFrame returns the first visible frame without applying the client",
            "// composition origin. Avatar layers often have negative origins.",
            "func DecodeDIMGFrame(data []byte) (*image.RGBA, error) {",
            "\tsprite, err := parseDIMG(data)",
            "\tif err != nil {",
            "\t\treturn nil, err",
            "\t}",
            "\tframe, err := firstVisibleFrame(sprite.frames)",
            "\tif err != nil {",
            "\t\treturn nil, err",
            "\t}",
            "\treturn frame.image, nil",
            "}"
          ]
        },
        {
          "startLine": 105,
          "endLine": 113,
          "lines": [
            "// DIMGToPreview renders only the first direction. Cycling all four character",
            "// directions would look like an animation but would actually rotate the item.",
            "// DIMG has no per-frame duration, so the GM preview uses a documented 100 ms",
            "// display interval.",
            "func DIMGToPreview(data []byte) (DIMGPreview, error) {",
            "\tsprite, err := parseDIMG(data)",
            "\tif err != nil {",
            "\t\treturn DIMGPreview{}, err",
            "\t}"
          ]
        },
        {
          "startLine": 155,
          "endLine": 205,
          "lines": [
            "\tif len(data) < dimgSpriteHeaderSize || !bytes.Equal(data[:len(dimgMagic)], dimgMagic) {",
            "\t\treturn dimgSprite{}, fmt.Errorf(\"item icon is not a QQF/DIMG resource\")",
            "\t}",
            "\tversion := binary.LittleEndian.Uint32(data[8:12])",
            "\tframeInfoSize := binary.LittleEndian.Uint32(data[12:16])",
            "\tframeCount := int(binary.LittleEndian.Uint32(data[16:20]))",
            "\tdirections := int(binary.LittleEndian.Uint32(data[20:24]))",
            "\twidth := int(binary.LittleEndian.Uint32(data[32:36]))",
            "\theight := int(binary.LittleEndian.Uint32(data[36:40]))",
            "\tif version != 65536 && version != 65537 {",
            "\t\treturn dimgSprite{}, fmt.Errorf(\"QQF/DIMG version %d is unsupported\", version)",
            "\t}",
            "\tif frameInfoSize != 24 {",
            "\t\treturn dimgSprite{}, fmt.Errorf(\"QQF/DIMG frame-info size %d is unsupported\", frameInfoSize)",
            "\t}",
            "\tif frameCount < 1 || frameCount > dimgMaxFrames || directions < 1 || directions > 32 || frameCount%directions != 0 {",
            "\t\treturn dimgSprite{}, fmt.Errorf(\"invalid QQF/DIMG frame/direction count %d/%d\", frameCount, directions)",
            "\t}",
            "\tif width < 1 || height < 1 || width > dimgMaxDimension || height > dimgMaxDimension {",
            "\t\treturn dimgSprite{}, fmt.Errorf(\"invalid QQF/DIMG canvas %dx%d\", width, height)",
            "\t}",
            "",
            "\toffset := dimgSpriteHeaderSize",
            "\tframes := make([]dimgFrame, 0, frameCount)",
            "\tfor index := 0; index < frameCount; index++ {",
            "\t\tif len(data)-offset < dimgFrameHeaderSize {",
            "\t\t\treturn dimgSprite{}, fmt.Errorf(\"QQF/DIMG frame %d header is truncated\", index)",
            "\t\t}",
            "\t\tif magic := binary.LittleEndian.Uint32(data[offset : offset+4]); magic != 0 {",
            "\t\t\treturn dimgSprite{}, fmt.Errorf(\"QQF/DIMG frame %d magic %#x is unsupported\", index, magic)",
            "\t\t}",
            "\t\tx := int(int32(binary.LittleEndian.Uint32(data[offset+4 : offset+8])))",
            "\t\ty := int(int32(binary.LittleEndian.Uint32(data[offset+8 : offset+12])))",
            "\t\tmode := binary.LittleEndian.Uint32(data[offset+12 : offset+16])",
            "\t\toffset += dimgFrameHeaderSize",
            "\t\tif mode == 0 {",
            "\t\t\tframes = append(frames, dimgFrame{x: x, y: y})",
            "\t\t\tcontinue",
            "\t\t}",
            "\t\tif len(data)-offset < dimgImageHeaderSize {",
            "\t\t\treturn dimgSprite{}, fmt.Errorf(\"QQF/DIMG frame %d image header is truncated\", index)",
            "\t\t}",
            "\t\tframeWidth := int(binary.LittleEndian.Uint32(data[offset : offset+4]))",
            "\t\tframeHeight := int(binary.LittleEndian.Uint32(data[offset+4 : offset+8]))",
            "\t\toffset += dimgImageHeaderSize",
            "\t\t// Some official four-direction layers encode an absent direction as a",
            "\t\t// non-zero pixel mode followed by a 0x0 image header. The client treats",
            "\t\t// that direction as empty; it is distinct from a partially-zero or",
            "\t\t// truncated image, which remains invalid below.",
            "\t\tif frameWidth == 0 && frameHeight == 0 {",
            "\t\t\tframes = append(frames, dimgFrame{x: x, y: y})"
          ]
        },
        {
          "startLine": 276,
          "endLine": 300,
          "lines": [
            "func unionFrameBounds(frames []dimgFrame) (image.Rectangle, int) {",
            "\tvar result image.Rectangle",
            "\tvisible := 0",
            "\tfor _, frame := range frames {",
            "\t\tif frame.image == nil {",
            "\t\t\tcontinue",
            "\t\t}",
            "\t\tbounds := frame.image.Bounds().Add(image.Pt(frame.x, frame.y))",
            "\t\tif visible == 0 {",
            "\t\t\tresult = bounds",
            "\t\t} else {",
            "\t\t\tresult = result.Union(bounds)",
            "\t\t}",
            "\t\tvisible++",
            "\t}",
            "\treturn result, visible",
            "}",
            "",
            "func composeDIMGFrame(frame dimgFrame, bounds image.Rectangle) *image.RGBA {",
            "\tresult := image.NewRGBA(image.Rect(0, 0, bounds.Dx(), bounds.Dy()))",
            "\tif frame.image != nil {",
            "\t\ttarget := frame.image.Bounds().Add(image.Pt(frame.x-bounds.Min.X, frame.y-bounds.Min.Y))",
            "\t\tdraw.Draw(result, target, frame.image, frame.image.Bounds().Min, draw.Over)",
            "\t}",
            "\treturn result"
          ]
        }
      ]
